<!DOCTYPE html>

<html lang="tr">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Göksu'ya Doğum Günü Sürprizi 🎂</title>

    <!-- Konfeti Efekti İçin Harici Kütüphane -->

    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

    <style>

        * { box-sizing: border-box; }



        body {

            /* Toz Pembe Tonlarında Yumuşak Geçişli Arka Plan */

            background: linear-gradient(135deg, #fde2e4 0%, #faccd7 50%, #f7cad0 100%);

            min-height: 100vh;

            margin: 0;

            display: flex;

            flex-direction: column;

            justify-content: center;

            align-items: center;

            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;

            text-align: center;

            color: #5c3d46;

            user-select: none;

            overflow: hidden;

        }



        /* Geçiş Efektleri */

        .fade-step {

            transition: opacity 0.5s ease, transform 0.5s ease;

            display: flex;

            flex-direction: column;

            align-items: center;

            justify-content: center;

            width: 100%;

        }



        .hidden {

            opacity: 0;

            pointer-events: none;

            transform: scale(0.9);

            position: absolute;

            visibility: hidden;

        }



        /* 1. Aşama - Karşılama Ekranı */

        .gift-icon {

            font-size: 5rem;

            margin-bottom: 20px;

            animation: bounce 2s infinite ease-in-out;

        }



        @keyframes bounce {

            0%, 100% { transform: translateY(0); }

            50% { transform: translateY(-15px); }

        }



        h1 {

            font-size: 2.5rem;

            margin: 0 0 15px 0;

            color: #4a2831;

            text-shadow: 1px 2px 4px rgba(255, 255, 255, 0.6);

        }



        .isim-baslik {

            font-size: 3rem;

            color: #d81b60;

            font-weight: 800;

            letter-spacing: 2px;

            margin: 0 0 30px 0;

            text-shadow: 0 0 25px rgba(216, 27, 96, 0.35);

            animation: parla 2s ease-in-out infinite;

        }



        @keyframes parla {

            0%, 100% { text-shadow: 0 0 25px rgba(216, 27, 96, 0.35); }

            50%      { text-shadow: 0 0 45px rgba(216, 27, 96, 0.85), 0 0 70px rgba(255, 105, 180, 0.5); }

        }



        .start-btn {

            background-color: #ffffff;

            color: #8b4f5e;

            border: 2px solid #f2b5d4;

            padding: 18px 40px;

            font-size: 1.3rem;

            font-weight: bold;

            border-radius: 50px;

            cursor: pointer;

            box-shadow: 0 8px 20px rgba(180, 100, 120, 0.15);

            transition: all 0.3s ease;

        }



        .start-btn:hover {

            transform: scale(1.08);

            box-shadow: 0 12px 25px rgba(180, 100, 120, 0.25);

            background-color: #fff0f3;

        }



        /* 2. Aşama - Geri Sayım Ekranı */

        .countdown-number {

            font-size: 8rem;

            font-weight: bold;

            color: #4a2831;

            text-shadow: 2px 4px 10px rgba(255, 255, 255, 0.8);

            margin: 0 0 20px 0;

            line-height: 1;

        }



        .countdown-text {

            font-size: 1.5rem;

            color: #5c3d46;

            padding: 15px 30px;

            border-radius: 30px;

            background: rgba(255, 255, 255, 0.45);

            backdrop-filter: blur(8px);

            max-width: 90%;

            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);

        }



        .clickable-instruction {

            cursor: pointer;

            background: rgba(255, 255, 255, 0.75);

            animation: pulse-bg 1.5s infinite;

        }



        @keyframes pulse-bg {

            0%, 100% { transform: scale(1); box-shadow: 0 0 0 rgba(255,255,255,0); }

            50% { transform: scale(1.03); box-shadow: 0 0 20px rgba(255, 182, 193, 0.8); }

        }



        /* 3. Aşama - Sürpriz Kartı */

        .surprise-card {

            opacity: 0;

            transform: translateY(30px);

            margin-top: 30px;

            background: rgba(255, 255, 255, 0.6);

            backdrop-filter: blur(12px);

            padding: 35px 40px;

            border-radius: 25px;

            box-shadow: 0 15px 35px rgba(180, 100, 120, 0.18);

            font-size: 1.25rem;

            line-height: 1.8;

            max-width: 85vw;

            border: 1px solid rgba(255, 255, 255, 0.8);

            transition: all 0.8s ease-out;

            color: #4a2831;

            font-weight: 500;

        }



        .surprise-card.show {

            opacity: 1;

            transform: translateY(0);

        }



        .kalp {

            display: inline-block;

            animation: atis 1s infinite;

        }



        @keyframes atis {

            0%, 100% { transform: scale(1); }

            25%      { transform: scale(1.35); }

            50%      { transform: scale(1); }

        }

    </style>

</head>

<body>



    <!-- 1. AŞAMA: Giriş / Karşılama Ekranı -->

    <div id="intro-step" class="fade-step">

        <div class="gift-icon">🎁</div>

        <h1>Bugün Özel Bir Gün...</h1>

        <div class="isim-baslik">Göksu 🌸</div>

        <button class="start-btn" onclick="startExperience()">Sürprizi Başlat 🎉</button>

    </div>



    <!-- 2. AŞAMA: Geri Sayım ve Üfleme Ekranı -->

    <div id="countdown-step" class="fade-step hidden">

        <div class="countdown-number" id="counter">5</div>

        <div class="countdown-text" id="instruction">(5) saniye sonra ekrana üfle 🎂</div>

        

        <div class="surprise-card" id="card">

            <p>

                Geçen zaman içinde çok fazla şey değişti ancak doğum gününü hatırlamak

                ve en iyi dileklerimi iletmek istedim yeni yaşının sana sağlık mutluluk

                ve aradığın tüm güzellikleri getirmesini dilerim Doğum günün kutlu olsun

                <span class="kalp">🫀</span>

            </p>

        </div>

    </div>



    <script>

        const introStep = document.getElementById('intro-step');

        const countdownStep = document.getElementById('countdown-step');

        const counterElement = document.getElementById('counter');

        const instructionElement = document.getElementById('instruction');

        const cardElement = document.getElementById('card');



        function startExperience() {

            introStep.classList.add('hidden');



            setTimeout(() => {

                countdownStep.classList.remove('hidden');

                runTimer();

            }, 500);

        }



        function runTimer() {

            let x = 5;



            const timer = setInterval(() => {

                x--;



                if (x > 0) {

                    counterElement.textContent = x;

                    instructionElement.textContent = `(${x}) saniye sonra ekrana üfle 🎂`;

                } else {

                    clearInterval(timer);

                    counterElement.textContent = "💨";

                    instructionElement.textContent = "Şimdi mumları üfle (Tıkla)! 🎂✨";

                    instructionElement.classList.add('clickable-instruction');

                    

                    instructionElement.addEventListener('click', blowOutCandle);

                }

            }, 1000);

        }



        function blowOutCandle() {

            counterElement.textContent = "✨";

            instructionElement.textContent = "İyi Ki Doğdun Göksu! 🍰🎉";

            instructionElement.classList.remove('clickable-instruction');

            cardElement.classList.add('show');



            // İlk konfeti patlaması

            confetti({

                particleCount: 150,

                spread: 100,

                origin: { y: 0.6 },

                colors: ['#f8bbd0', '#f48fb1', '#ec407a', '#ffd1dc', '#ffffff', '#d81b60']

            });



            // Birkaç saniye sonra ikinci patlama (daha güzel görünsün diye)

            setTimeout(() => {

                confetti({

                    particleCount: 100,

                    angle: 60,

                    spread: 70,

                    origin: { x: 0 },

                    colors: ['#f8bbd0', '#f48fb1', '#ec407a', '#ffd1dc', '#ffffff']

                });

                confetti({

                    particleCount: 100,

                    angle: 120,

                    spread: 70,

                    origin: { x: 1 },

                    colors: ['#f8bbd0', '#f48fb1', '#ec407a', '#ffd1dc', '#ffffff']

                });

            }, 400);

        }

    </script>



</body>

</html> 

